dbMemo "SQL" ="SELECT DEBITEUR.Déb_Situation, DEBITEUR.Déb_Code, Round([DEBITEUR].[Déb_Mont_Pri"
    "n_m1],2) AS Déb_Mont_Prin_m1, Round([DEBITEUR].[Déb_Mont_Prin_m2],2) AS Déb_Mont"
    "_Prin_m2, Round(Sum(IIf([CG_Code_Action]<>7 And [Enc_Situation] Is Not Null And "
    "[Enc_Montant_mo]=1,[Enc_Prin_m1],0)),2) AS Déb_Mont_Reversé_m1, Round(Sum(IIf([C"
    "G_CODE_Action]<>7 And [Enc_Situation] Is Not Null And [Enc_Montant_mo]=2,[Enc_Pr"
    "in_m2],0)),2) AS Déb_Mont_Reversé_m2, Round(Sum(IIf([CG_Code_Action]<>7,[Enc_Pri"
    "n_m1],0)),2) AS Déb_Prin_Enc_m1, Round(Sum(IIf([CG_Code_Action]<>7,[Enc_Prin_m2]"
    ",0)),2) AS Déb_Prin_Enc_m2\015\012FROM CODE_GESTION INNER JOIN (DEBITEUR LEFT JO"
    "IN ENCAISSEMENT ON DEBITEUR.Déb_Code = ENCAISSEMENT.Enc_Code_Débiteur) ON CODE_G"
    "ESTION.CG_Code = DEBITEUR.Déb_Situation\015\012WHERE [Déb_Code_Client]='88961' A"
    "ND [Déb_MonnaieEnCours]=2\015\012GROUP BY DEBITEUR.Déb_Situation, DEBITEUR.Déb_C"
    "ode, Round([DEBITEUR].[Déb_Mont_Prin_m1],2), Round([DEBITEUR].[Déb_Mont_Prin_m2]"
    ",2);\015\012"
